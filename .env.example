VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server only. Do not prefix these with VITE_ — that would ship them to the browser.
# OpenAI-compatible chat endpoint (OpenAI, Groq, OpenRouter, …).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Supabase service role. Enforces the daily tutor cap. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=
